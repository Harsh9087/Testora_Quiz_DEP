# Database connection string (PostgreSQL in production, SQLite for local testing)
DATABASE_URL="sqlite:///quiz.db"
# Example PostgreSQL URL: postgresql://postgres:password@localhost:5432/testora_quiz

# JWT Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
FRONTEND_URL="http://localhost:3000"

# AI Paper Synthesis (Google Gemini API)
GEMINI_API_KEY=""

# Email Credentials for Candidate Invitations & Passcodes
SMTP_HOST="email-smtp.ap-southeast-2.amazonaws.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="support@testoraquiz.com"
EMAILS_FROM_NAME="TestoraQuiz Examination System"

# Google OAuth Single Sign-On
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ════════════════════════════════════════════════════════════════════════════════
# RAZORPAY PAYMENT GATEWAY CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════
# Test Mode:
#   1. Sign in to https://dashboard.razorpay.com/
#   2. Switch toggle to "Test Mode"
#   3. Go to Settings -> API Keys -> Generate Key
#   4. Set RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXX"
#   5. Set RAZORPAY_KEY_SECRET="YourTestKeySecret"
#
# Live Mode:
#   1. Complete KYC verification on Razorpay Dashboard
#   2. Switch toggle to "Live Mode"
#   3. Go to Settings -> API Keys -> Generate Live Key
#   4. Set RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXXXX"
#   5. Set RAZORPAY_KEY_SECRET="YourLiveKeySecret"
#
# Webhook Configuration:
#   Webhook URL: https://your-backend-domain.com/api/v1/payments/webhook
#   Active Events to Subscribe:
#     - payment.captured
#     - order.paid
#     - payment.failed
#   Webhook Secret: Set a secure alphanumeric string (e.g. 32 chars) in both
#     the Razorpay Dashboard webhook settings and below:
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Per-Test Mandatory Billing Formula Configuration:
# Billable units = student_count × question_count
# Rate per billable unit in integer paise (10 paise = ₹0.10)
PRICE_PER_UNIT_PAISE=10

# Minimum order amount threshold in paise (Razorpay minimum is 100 paise = ₹1.00)
MIN_ORDER_AMOUNT_PAISE=100

# GST / Tax Percentage (Default 18% in India)
GST_PERCENTAGE=18
